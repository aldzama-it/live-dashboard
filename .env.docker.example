# Compose/project identity
COMPOSE_PROJECT_NAME=azm-live-dashboard

# Published host ports. Change these if another application already uses them.
FRONTEND_HOST_PORT=5173
LARAVEL_HOST_PORT=8001
QMS_HOST_PORT=5002
MYSQL_HOST_PORT=3306

# Public URL used by the browser for the QMS API during the frontend build.
QMS_PUBLIC_URL=http://127.0.0.1:5002
QMS_ALLOWED_ORIGIN=http://127.0.0.1:5173

# MySQL credentials used by Laravel and the NLP analyzer.
DB_NAME=dashboard_all_division
DB_USER=azm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-me
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=azm-dashboard-mysql

# Laravel application settings. APP_KEY must be a valid Laravel key before use.
APP_NAME=AZM Live Dashboard
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1:8001
SESSION_DRIVER=database
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173,127.0.0.1,localhost

# QMS workbook location on the host. Keep files outside the image.
QMS_DATA_PATH=./qms-service/data
KPI_EXCEL_PATH=data/1. Monitoring KPI 2026.xlsx
RISK_EXCEL_PATH=data/3. RISK ASSESMENT - Consolidated FRM-602-009.xlsx
FOLLOWUP_BOD_EXCEL_PATH=data/4. FRM-AZM-602-021 Follow up Evaluasi dan Strategi BoD Register.xlsx
CORRECTIVE_ACTION_EXCEL_PATH=data/2. CORRECTIVE ACTION REGISTER.xlsx
KAIZEN_RECAP_EXCEL_PATH=data/5. KAIZEN RECAP.xlsx

# Optional image/container names.
FRONTEND_IMAGE=azm-live-dashboard-frontend:local
LARAVEL_IMAGE=azm-live-dashboard-laravel:local
QMS_IMAGE=azm-live-dashboard-qms:local
ANALYZER_IMAGE=azm-live-dashboard-nlp:local
FRONTEND_CONTAINER_NAME=azm-dashboard-frontend
LARAVEL_CONTAINER_NAME=azm-dashboard-laravel
QMS_CONTAINER_NAME=azm-dashboard-qms
ANALYZER_CONTAINER_NAME=azm-dashboard-nlp

# NLP analyzer database connection. Defaults to the Compose MySQL service.
ANALYZER_DB_HOST=mysql
ANALYZER_DB_PORT=3306
ANALYZER_DB_USER=azm
ANALYZER_DB_PASSWORD=change-me

# Static bridge network configuration. Change subnet, gateway, and IPs together.
DASHBOARD_NETWORK_NAME=azm-live-dashboard-net
DASHBOARD_NETWORK_SUBNET=172.31.0.0/24
DASHBOARD_NETWORK_GATEWAY=172.31.0.1
MYSQL_IPV4_ADDRESS=172.31.0.10
LARAVEL_IPV4_ADDRESS=172.31.0.11
FRONTEND_IPV4_ADDRESS=172.31.0.12
QMS_IPV4_ADDRESS=172.31.0.13
ANALYZER_IPV4_ADDRESS=172.31.0.14

# Persistent Docker volume names.
MYSQL_VOLUME_NAME=azm-dashboard-mysql-data
LARAVEL_STORAGE_VOLUME_NAME=azm-dashboard-laravel-storage
QMS_STORAGE_VOLUME_NAME=azm-dashboard-qms-storage
